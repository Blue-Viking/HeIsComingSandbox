from collections import deque
from typing import TYPE_CHECKING

from ..entities import Event, EventDispatcher, Trigger

if TYPE_CHECKING:
    from ..entities import Player


class CombatEngine:
    def __init__(self, player_a: "Player", player_b: "Player") -> None:
        self.players = [player_a, player_b]
        self.event_queue = deque()
        self.dispatcher = EventDispatcher()
        self.current_player: "Player | None" = None
        self.opponent: "Player | None" = None
        self.round_count = 0
        self.is_active = True

        self._register_equipment_triggers()
        self._determine_initiative()

        self.emit(Event("BattleStart", {}))
        self.process_events()

    def _register_equipment_triggers(self) -> None:
        """Register trigger effects from equipment for both players."""
        for player in self.players:
            for equipment in player.equipment:
                if hasattr(equipment, "triggers"):
                    for trigger in equipment.triggers:
                        self.dispatcher.register_trigger(trigger, player)

    def _determine_initiative(self) -> None:
        """Determine turn order based on player stats."""
        # Simple initiative: higher speed stat goes first
        if self.players[0].get_stat("speed") >= self.players[1].get_stat("speed"):
            self.current_player = self.players[0]
            self.opponent = self.players[1]
        else:
            self.current_player = self.players[1]
            self.opponent = self.players[0]

        self.emit(Event("InitiativeResolved", {
            "first_player": self.current_player.name
        }))

    def emit(self, event: Event) -> None:
        """Queue an event to be processed."""
        self.event_queue.append(event)

    def process_events(self) -> None:
        """Process all queued events."""
        while self.event_queue and self.is_active:
            event = self.event_queue.popleft()
            self.dispatcher.dispatch(event)
            self._check_battle_end()

    def execute_round(self) -> None:
        """Execute one full round of combat."""
        if not self.is_active:
            return

        self.round_count += 1
        self.emit(Event("RoundStart", {"round": self.round_count}))

        # Current player takes action
        action = self.current_player.decide_action(self.opponent)
        self._execute_action(action)

        # Check if opponent is defeated
        if self._is_defeated(self.opponent):
            self.is_active = False
            self.emit(Event("BattleEnd", {
                "winner": self.current_player.name,
                "rounds": self.round_count
            }))
            return

        # Swap turns
        self.current_player, self.opponent = self.opponent, self.current_player
        self.emit(Event("RoundEnd", {"round": self.round_count}))
        self.process_events()

    def _execute_action(self, action: dict) -> None:
        """Execute an action taken by the current player."""
        action_type = action.get("type")

        if action_type == "attack":
            self._execute_attack(self.current_player, self.opponent)
        elif action_type == "defend":
            self._execute_defend(self.current_player)
        elif action_type == "skill":
            self._execute_skill(self.current_player, self.opponent, action)
        elif action_type == "item":
            self._execute_item(self.current_player, action)

        self.process_events()

    def _execute_attack(self, attacker: "Player", defender: "Player") -> None:
        """Execute a basic attack."""
        damage = attacker.calculate_damage(defender)
        defender.take_damage(damage)

        self.emit(Event("Attack", {
            "attacker": attacker.name,
            "defender": defender.name,
            "damage": damage
        }))

    def _execute_defend(self, player: "Player") -> None:
        """Execute a defend action."""
        player.apply_buff("defense", 1.5, 1)  # 50% defense boost for 1 turn
        self.emit(Event("Defend", {"player": player.name}))

    def _execute_skill(self, attacker: "Player", defender: "Player", action: dict) -> None:
        """Execute a skill action."""
        skill_name = action.get("skill")
        # TODO: Implement skill system
        self.emit(Event("SkillUsed", {
            "player": attacker.name,
            "skill": skill_name
        }))

    def _execute_item(self, player: "Player", action: dict) -> None:
        """Execute an item use action."""
        item_name = action.get("item")
        # TODO: Implement item system
        self.emit(Event("ItemUsed", {
            "player": player.name,
            "item": item_name
        }))

    def _is_defeated(self, player: "Player") -> bool:
        """Check if a player has been defeated."""
        return player.current_hp <= 0

    def _check_battle_end(self) -> None:
        """Check if the battle has ended."""
        if self._is_defeated(self.opponent):
            self.is_active = False
            self.emit(Event("BattleEnd", {
                "winner": self.current_player.name,
                "rounds": self.round_count
            }))

    def get_battle_state(self) -> dict:
        """Return the current state of the battle."""
        return {
            "round": self.round_count,
            "is_active": self.is_active,
            "current_turn": self.current_player.name,
            "players": [
                {
                    "name": player.name,
                    "hp": player.current_hp,
                    "max_hp": player.max_hp,
                    "status": "alive" if not self._is_defeated(player) else "defeated"
                }
                for player in self.players
            ]
        }
